{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create task (success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Task returned', () => pm.expect(json.data._id).to.be.a('string'));",
              "pm.collectionVariables.set('taskId', json.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build portfolio website\",\n  \"description\": \"Design and deploy my personal portfolio\",\n  \"status\": \"pending\",\n  \"dueDate\": \"2026-12-01\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
      }
    },
    {
      "name": "2. Get all tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
      }
    },
    {
      "name": "3. Get single task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "4. Update task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Status updated', () => pm.expect(pm.response.json().data.status).to.eql('in-progress'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"in-progress\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "5. Invalid task ID (expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/tasks/not-a-valid-id", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "not-a-valid-id"] }
      }
    },
    {
      "name": "6. Task not found (expects 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/tasks/64b7f0c2e4b0a1a2b3c4d5e6", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "64b7f0c2e4b0a1a2b3c4d5e6"] }
      }
    },
    {
      "name": "7. Missing required title (expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"No title here\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
      }
    },
    {
      "name": "8. Invalid status (expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Bad status\",\n  \"status\": \"done\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
      }
    },
    {
      "name": "9. AI plan task (success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const plan = pm.response.json().plan;",
              "pm.test('Plan has expected fields', () => {",
              "  pm.expect(plan.summary).to.be.a('string');",
              "  pm.expect(['low','medium','high']).to.include(plan.priority);",
              "  pm.expect(plan.estimatedHours).to.be.a('number');",
              "  pm.expect(plan.steps).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"I need to build a portfolio website within three days.\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/ai/plan-task", "host": ["{{baseUrl}}"], "path": ["api", "ai", "plan-task"] }
      }
    },
    {
      "name": "10. AI plan task - missing description (expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"   \"\n}" },
        "url": { "raw": "{{baseUrl}}/api/ai/plan-task", "host": ["{{baseUrl}}"], "path": ["api", "ai", "plan-task"] }
      }
    },
    {
      "name": "11. Delete task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
      }
    }
  ]
}
